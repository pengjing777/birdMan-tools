page{background:#f3f5fc;min-height:100vh}.page{padding:36rpx}.title{font-size:52rpx;font-weight:600;margin:20rpx 0 35rpx}.card{background:#fff;border-radius:28rpx;padding:30rpx;box-shadow:0 10rpx 30rpx #22304a12}.section-title{font-size:27rpx;color:#69717d;font-weight:700;margin:12rpx 0}.gap{margin-top:30rpx}.card input,.picker{height:88rpx;line-height:88rpx;border:1rpx solid #e5e7ef;border-radius:18rpx;padding:0 24rpx;margin:14rpx 0;font-size:29rpx;background:#fbfcfe}.bird-entry{display:flex;justify-content:space-between;background:#fbfcfe;border:1rpx solid #e5e7ef;border-radius:18rpx;padding:24rpx;font-size:28rpx;text-align:left}.bird-entry text{font-size:38rpx;color:#89909a}.save{margin-top:40rpx;background:#52899b;color:#fff;border-radius:18rpx;font-size:30rpx}
