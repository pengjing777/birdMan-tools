<view class="page"><view class="title">偏好设置</view><view class="card"><view class="section-title">默认地点</view><input placeholder="省 / 直辖市" value="{{province}}" bindinput="setProvince"/><input placeholder="城市" value="{{city}}" bindinput="setCity"/><input placeholder="区县（可留空）" value="{{district}}" bindinput="setDistrict"/><view class="section-title gap">模型</view><picker mode="selector" range="{{models}}" value="{{modelIndex}}" bindchange="setModel"><view class="picker">{{modelLabel}}　⌄</view></picker><view class="section-title gap">max_tokens（可留空）</view><input type="number" placeholder="留空则使用接口默认值" value="{{maxTokens}}" bindinput="setMaxTokens"/><view class="section-title gap">鸟种</view><button class="bird-entry" bindtap="openBirdPreferences">设置关注 / 不关注鸟种 <text>›</text></button><button class="save" bindtap="save">保存设置</button></view></view>
