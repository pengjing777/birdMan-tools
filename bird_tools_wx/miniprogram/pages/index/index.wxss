page{background:#f7f8f5;color:#1e2d2a;height:100%}.page{min-height:100vh;padding:env(safe-area-inset-top) 30rpx 220rpx;background:radial-gradient(circle at 98% 6%,#e2eee6 0,#f7f8f5 30%,#f7f8f5 100%)}.header{height:112rpx;display:flex;align-items:center;justify-content:center;position:relative}.menu{position:absolute;left:0;width:74rpx;height:74rpx;padding:19rpx 15rpx;box-sizing:border-box;border-radius:50%;background:#eef2ec}.menu view{height:4rpx;margin:6rpx 0;border-radius:99rpx;background:#29423b}.menu view:nth-child(2){width:28rpx}.header-mark{font-size:24rpx;letter-spacing:5rpx;color:#698077}.model{position:absolute;right:0;padding:12rpx 21rpx;border:1rpx solid #dce6df;border-radius:99rpx;background:#fff;color:#4c8071;font-size:23rpx;font-weight:700;box-shadow:0 5rpx 14rpx #29423b0b}.hero{margin-top:72rpx}.hero-top{display:flex;align-items:center;gap:18rpx;margin-bottom:35rpx}.bird-mark{width:84rpx;height:84rpx;border-radius:29rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#1d5750,#5da089);color:#eff7ee;box-shadow:0 15rpx 28rpx #2b66562b}.bird-mark text{font-size:62rpx;line-height:1;transform:rotate(-18deg)}.hero-note{display:flex;flex-direction:column;gap:6rpx}.hero-note text:first-child{font-size:19rpx;letter-spacing:3rpx;color:#5a8e7f;font-weight:700}.hero-note text:last-child{font-size:23rpx;color:#788781}.greeting{display:block;font-size:30rpx;color:#77847e;letter-spacing:1rpx}.hero-title{display:block;margin-top:12rpx;font-size:60rpx;line-height:1.2;font-weight:650;letter-spacing:-2rpx;color:#20322c}.hero-sub{display:block;margin-top:25rpx;color:#78857f;font-size:27rpx;line-height:1.7}.section-caption{display:flex;align-items:center;gap:16rpx;margin-top:61rpx;margin-bottom:20rpx;color:#60746b;font-size:23rpx;font-weight:700;letter-spacing:2rpx}.section-caption view{width:80rpx;height:1rpx;background:#cfdcd4}.chips{display:flex;flex-direction:column;gap:15rpx}.chips button{width:100%;height:104rpx;margin:0;box-sizing:border-box;display:flex;align-items:center;text-align:left;padding:0 24rpx;border:1rpx solid #e2e9e3;border-radius:25rpx;background:#fff;color:#31433c;font-size:27rpx;line-height:1.2;box-shadow:0 8rpx 22rpx #233e3308}.chip-icon{width:44rpx;color:#4e8b75;font-size:36rpx;margin-right:13rpx}.chip-arrow{margin-left:auto;font-size:39rpx;color:#8eaaa0;font-weight:300}.messages{height:calc(100vh - 330rpx);padding:20rpx 0}.message{max-width:86%;margin:22rpx 0;padding:22rpx 26rpx;border-radius:28rpx;font-size:29rpx;line-height:1.65;white-space:pre-wrap}.message.user{margin-left:auto;background:#4e8374;color:#fff;border-bottom-right-radius:8rpx}.message.assistant{background:#fff;border:1rpx solid #e5e9e5;border-bottom-left-radius:8rpx;box-shadow:0 8rpx 23rpx #233e3308}.loading{color:#74847d}.details{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #e5e7ef}.details-title{font-weight:700;margin-bottom:10rpx}.location{display:flex;flex-direction:column;padding:12rpx 0;border-bottom:1rpx solid #eef0f4}.location-name{font-weight:700}.panel{position:fixed;z-index:8;top:110rpx;left:22rpx;padding:12rpx;background:#fff;border-radius:20rpx;box-shadow:0 15rpx 45rpx #22304a2b}.panel button{display:block;padding:18rpx 28rpx;text-align:left;background:#fff;font-size:27rpx}.composer{position:fixed;z-index:7;left:20rpx;right:20rpx;bottom:24rpx;padding:19rpx 18rpx 19rpx 22rpx;display:flex;align-items:flex-end;background:#fff;border:1rpx solid #e0e8e2;border-radius:34rpx;box-shadow:0 -8rpx 32rpx #223d3014}.composer-label{width:40rpx;padding-top:17rpx;color:#5f9c85;font-size:28rpx}.composer textarea{flex:1;min-height:62rpx;padding-top:12rpx;font-size:29rpx;line-height:1.5;color:#263931}.send{width:82rpx;height:82rpx;margin-left:10rpx;border-radius:27rpx;background:#315e51;color:#fff;font-size:45rpx;line-height:1;box-shadow:0 8rpx 16rpx #315e5133}.send[disabled]{opacity:.5}
