<view class="page">
  <view class="header"><view class="menu" bindtap="togglePanel"><view></view><view></view><view></view></view><view class="header-mark"><text>观鸟助手</text></view><view class="model" bindtap="toggleModel">{{modelLabel}}</view></view>
  <view class="hero" wx:if="{{messages.length === 0}}"><view class="hero-top"><view class="bird-mark"><text>⌁</text></view><view class="hero-note"><text>AI BIRDING</text><text>记录每一次自然相遇</text></view></view><text class="greeting">你好，鸟友</text><text class="hero-title">今天，想看见<br/>什么特别的鸟？</text><text class="hero-sub">输入地点、鸟种或观鸟问题，获取近期记录与实用建议。</text><view class="section-caption"><text>试着这样问</text><view></view></view><view class="chips"><button wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="useSuggestion"><text class="chip-icon">{{index === 0 ? '⌖' : index === 1 ? '⌁' : '◌'}}</text><text>{{item}}</text><text class="chip-arrow">›</text></button></view></view>
  <scroll-view wx:else class="messages" scroll-y scroll-into-view="{{scrollInto}}"><view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message {{item.role}}"><text selectable="true">{{item.content}}</text><view wx:if="{{item.locations && item.locations.length}}" class="details"><view class="details-title">地点明细</view><view wx:for="{{item.locations}}" wx:key="location" class="location"><text class="location-name">{{item.location}}</text><text>{{item.birds}}</text></view></view></view><view wx:if="{{loading}}" class="message assistant loading">正在查询并分析…</view></scroll-view>
  <view wx:if="{{panelOpen}}" class="panel"><button bindtap="openPreferences">偏好设置</button><button bindtap="clearChat">清空对话</button></view>
  <view class="composer"><view class="composer-label">✦</view><textarea value="{{input}}" bindinput="onInput" bindconfirm="send" confirm-type="send" auto-height placeholder="问问 AI 观鸟"></textarea><button class="send" bindtap="send" disabled="{{loading}}">↑</button></view>
</view>
